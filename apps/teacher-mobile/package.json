    "expo-sharing": "57.0.22",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "sharp": "0.35.5",
    "typescript": "~6.0.2"
